# Modelo da configuração da aquisição. Copie para config.env (que o git ignora) e preencha.
# NUNCA coloque senha neste arquivo de exemplo nem envie o config.env para o GitHub.

# Servidor FTP da estação (dentro da rede do campus)
FTP_HOST=COLOQUE_O_ENDERECO_DO_FTP
FTP_USER=COLOQUE_O_USUARIO
FTP_PASS=COLOQUE_A_SENHA

# Pasta dos arquivos .txt no servidor
FTP_DIR=/

# Opcionais
# FTP_PORT=21
# FTP_TLS=0
